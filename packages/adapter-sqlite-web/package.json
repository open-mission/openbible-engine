{
  "name": "@openbible/adapter-sqlite-web",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker/worker.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@openbible/engine": "workspace:*",
    "@openbible/engine-core": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-worker.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "test": "vitest run tests",
    "test:tdd": "vitest run tests/unit",
    "test:browser": "node scripts/test-browser.mjs",
    "test:coverage": "vitest run tests --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@openbible/engine-testing": "workspace:*",
    "@playwright/test": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
