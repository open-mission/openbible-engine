    { "path": "../../packages/engine-core" },
    { "path": "../../packages/engine" },
    { "path": "../../packages/adapter-http" },
    { "path": "../../packages/adapter-sqlite-node" }
  ],
  "exclude": ["node_modules", "dist", "coverage", "tests"]
}
