{
  "name": "@openbible/consumer-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node scripts/migrate-auth.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-web-assets.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:tdd && pnpm run build",
    "test": "vitest run",
    "test:tdd": "vitest run tests",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@openbible/adapter-sqlite-web": "workspace:*",
    "@openbible/adapter-http": "workspace:*",
    "@openbible/engine": "workspace:*",
    "@openbible/engine-core": "workspace:*",
    "@libsql/client": "^0.8.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@libsql/kysely-libsql": "0.4.1",
    "@openbible/adapter-sync-turso": "workspace:*",
    "@openbible/sync": "workspace:*",
    "@openbible/sync-core": "workspace:*",
    "better-auth": "1.7.2",
    "kysely": "^0.29.5",
    "next": "^15.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
