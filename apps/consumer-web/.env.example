# Public API proxy for the catalog and browser-safe downloads.
NEXT_PUBLIC_BIBLE_API_URL=https://openbible-prod.vercel.app

# Public R2 directory used as a direct-download fallback.
NEXT_PUBLIC_BIBLE_BUCKET_URL=https://pub-2e657f1c9c644712ad9474513a7ad79b.r2.dev/bibles

# Server-only Better Auth and Turso/libSQL configuration. Never expose these as NEXT_PUBLIC_* values.
BETTER_AUTH_SECRET=replace-with-a-runtime-secret
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=libsql://replace-with-turso-database.turso.io
DATABASE_TURSO_TOKEN=replace-with-a-runtime-token
