<template name="search-area" args="query results">
  <column gap="12" grow="1">
    <column gap="4">
      <text size="heading">Busca</text>
      <text>Pesquise somente nas versões instaladas.</text>
    </column>
    <row gap="8" cross="center">
      <search-field grow="1" text="{query}" placeholder="Pesquisar nas Escrituras" label="Pesquisar versículos" on-input="query_edit" on-submit="search_submit" />
      <button variant="primary" on-press="search_submit">Pesquisar</button>
    </row>
    <scroll grow="1">
      <column gap="8">
        <if test="{showSearchResults}">
          <for each="results" key="id" as="result">
            <list-item icon="search" label="Abrir resultado" on-press="show_reader">
              <column grow="1">
                <text>{result.reference}</text>
                <text wrap="true">{result.text}</text>
              </column>
            </list-item>
          </for>
        </if>
      </column>
    </scroll>
  </column>
</template>
